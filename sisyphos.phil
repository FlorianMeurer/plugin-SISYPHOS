
sisyphos{
  element_string = ""
  .type = str
  
  adjustment_eV = ""
  .type = str

  resolution = 0.0
  .type = float

  use_nos2 = False
  .type = bool

  perform_disp_ref = False
  .type = bool

  benchmark_mode = False
  .type = bool

  henke = False
  .type = bool

  sasaki = False
  .type = bool

  brennan = False
  .type = bool

  energies_from_headers = False
  .type = bool

  energies_from_ins = False
  .type = bool

  indiv_disp = True
  .type = bool

  update_weight = True
  .type = bool

  struct_only = True
  .type = bool

  use_refine_settings = False
  .type = bool

  refine{
    program = olex2.refine
    .type = str
    method = Gauss-Newton
    .type = str
    max_peaks = 0
    .type = int
    use_mask = False
    .type = bool
    mask_program = Olex2
    .type = str
    solvent_radius = ""
    .type = str
    truncation_radius = ""
    .type = str
  }

  gui{
    location = 'tools'
      .type = str
      .help = The tab item where the SISYPHOS GUI shall appear.
    before = 'images'
      .type = str
      .help = The tool before which the SISYPHOS GUI shall appear.
    }
}
